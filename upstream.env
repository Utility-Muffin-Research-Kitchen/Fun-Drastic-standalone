# Fun DraStic by tenlevels.
#
# Fun DraStic is his project; this repository only packages it for Leaf on the
# MLP1. The hook is built from his source, which lives in the sibling
# Fun-Drastic-src checkout (a verbatim mirror of the source he donated) the way
# steward-fu-nds does for the primary DraStic package. Point
# FUN_DRASTIC_SRC_DIR at another checkout to build a working tree.
FUN_DRASTIC_AUTHOR=tenlevels
FUN_DRASTIC_VERSION=2026-09-04
FUN_DRASTIC_SOURCE_REPO=https://github.com/Utility-Muffin-Research-Kitchen/Fun-Drastic-src

# The source drop the mirror was cut from, kept for provenance. The build reads
# the checkout, not this archive; the hash is here so a mirror can be audited
# back to what he actually sent.
FUN_DRASTIC_SOURCE_DROP=fun_drastic.zip
FUN_DRASTIC_SOURCE_DROP_SHA256=c96a469c3e2bd79ad3e8175b9d150b1671bc11d323552f5ed73605d0731af0e5

# DraStic itself. Exophase's proprietary freeware, bundled by tenlevels' tree
# and redistributed unmodified - never built here, and never the thing this
# repository is about. Each file is pinned because we do not compile it: a
# source drop that quietly swaps the emulator has to be reviewed and re-pinned
# before it can ship.
DRASTIC_BINARY_SHA256=dab3275ef772451b9235b78e64b2d0d041a28ac22937668231088c76b709e218
DRASTIC_BIOS_ARM7_SHA256=6ad5072c3920fd6c8eba2c49d2dd058c296564a11d6013807124a919cf0d66e6
DRASTIC_BIOS_ARM9_SHA256=0a4e88c5dfd20ce669b8df45d009974f23fe7cb9b1f2148dbf30b6445eca9bc5
DRASTIC_GAME_DATABASE_SHA256=799fa38ede70742fa8ca297e295caf3b878d0c7ee34643f1f4499d59b7ee4123
DRASTIC_USRCHEAT_SHA256=a69264226312f584caf43343d27f0d38213d4fb01758ca01880f509c98fbeb29
