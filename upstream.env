# Fun DraStic by tenlevels.
#
# Upstream is frozen: tenlevels is not working on Fun DraStic in the near
# future, so there is no branch, tag, or commit to track. The input is a
# single binary archive, pinned by hash.
#
# FUN_DRASTIC_ARCHIVE_URL points at this repository's own release asset, which
# is the archive's authorized home. The asset is immutable: replacing it means
# cutting a new release and re-pinning both the URL and the hash here.
#
# A local override is still accepted, and only when it matches
# FUN_DRASTIC_ARCHIVE_SHA256:
#
#   make package-mlp1 FUN_DRASTIC_ARCHIVE=/absolute/path/to/drastic.zip
FUN_DRASTIC_ARCHIVE_NAME=drastic.zip
FUN_DRASTIC_ARCHIVE_URL=https://github.com/Utility-Muffin-Research-Kitchen/Fun-Drastic-standalone/releases/download/upstream/drastic-2026-09-01/drastic.zip
FUN_DRASTIC_ARCHIVE_SHA256=63dcf22d5ab06db0ca797567aa6597ce8b1e99080d1b86f92648cc155641d302
FUN_DRASTIC_VERSION=2026-09-01
FUN_DRASTIC_AUTHOR=tenlevels
