# Fun DraStic by tenlevels.
#
# Upstream is frozen: tenlevels is not working on Fun DraStic in the near
# future, so there is no branch, tag, or commit to track. The input is a
# single binary archive, pinned by hash.
#
# FUN_DRASTIC_ARCHIVE_URL is intentionally empty. The archive has no authorized
# public home yet; supply the reviewed copy explicitly:
#
#   make package-mlp1 FUN_DRASTIC_ARCHIVE=/absolute/path/to/drastic.zip
#
# A local override is only accepted when it matches FUN_DRASTIC_ARCHIVE_SHA256.
# Once an immutable URL exists, set it here and the fetch script will use it.
FUN_DRASTIC_ARCHIVE_NAME=drastic.zip
FUN_DRASTIC_ARCHIVE_URL=
FUN_DRASTIC_ARCHIVE_SHA256=63dcf22d5ab06db0ca797567aa6597ce8b1e99080d1b86f92648cc155641d302
FUN_DRASTIC_VERSION=2026-09-01
FUN_DRASTIC_AUTHOR=tenlevels
